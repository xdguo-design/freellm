{
  "schemaVersion": 1,
  "windowDays": 3,
  "minScore": 3,
  "minEntities": 1,
  "minKeywords": 2,
  "entityWeight": 3,
  "keywordWeight": 1,
  "entityScoreCap": 6,
  "keywordScoreCap": 3,
  "minArticleItems": 3,
  "maxAcceptedItems": 15,
