      "label": "火山方舟 50 万 Token 安心体验 API",
      "productType": "api",
      "prerequisites": [
        "火山方舟新用户资格",
        "安心体验模式仍可开启",
        "ARK_API_KEY"
      ],
      "steps": [
        {
          "title": "开启安心体验",
          "detail": "在开通任一模型服务前先开启安心体验模式；关闭后无法重新开启。"
        },
        {
          "title": "创建 API Key",
          "detail": "在 API Key 管理创建 ModelArk API Key，并仅保存在服务端环境变量。"
        },
        {
          "title": "发送最小请求",
          "detail": "调用北京地域 v3 OpenAI 兼容 ChatCompletions endpoint；模型 ID 以控制台当前支持列表为准。",
          "command": "curl https://ark.cn-beijing.volces.com/api/v3/chat/completions -H 'Authorization: Bearer ${ARK_API_KEY}' -H 'Content-Type: application/json' -d '{\"model\":\"doubao-1-5-pro-32k-250115\",\"messages\":[{\"role\":\"user\",\"content\":\"你好\"}]}'",
          "expected": "返回 chat completion；开通管理页免费额度减少。"
        },
        {
          "title": "验证费用保护",
          "detail": "确认安心体验仍开启；免费额度耗尽时模型服务应暂停并返回限额错误，而不是继续产生模型推理费用。"
        }
      ],
      "endpoint": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
      "auth": "Authorization: Bearer API key",
      "example": "curl https://ark.cn-beijing.volces.com/api/v3/chat/completions -H 'Authorization: Bearer ${ARK_API_KEY}' -H 'Content-Type: application/json' -d '{\"model\":\"doubao-1-5-pro-32k-250115\",\"messages\":[{\"role\":\"user\",\"content\":\"你好\"}]}'",
      "validation": "请求成功；免费推理额度扣减；额度耗尽时安心体验自动暂停模型服务。附加插件/知识库费用需另行检查。",
